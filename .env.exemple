# Clés secrètes de l'usine — ne jamais les envoyer par chat ni les mettre dans un storyboard.
# Jeton Claude Code (abonnement Claude) : obtenu avec « claude setup-token »
CLAUDE_CODE_OAUTH_TOKEN=
# ElevenLabs → Profil → API Keys
ELEVENLABS_API_KEY=
# Pixabay (images de fond) : pixabay.com/api/docs, connecté à ton compte
PIXABAY_API_KEY=
# Upload-Post (seulement en mode « programmer ») → Dashboard → API Keys
UPLOAD_POST_API_KEY=
# Telegram : jeton donné par @BotFather, et ton identifiant de discussion (voir MISE_EN_SERVICE.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# « manuel » : tu publies toi-même depuis Telegram ; « programmer » : Upload-Post publie seul
MODE_PUBLICATION=manuel
